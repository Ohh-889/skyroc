{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "React Admin Debugger",
      "url": "http://localhost:9527",
      "webRoot": "${workspaceFolder}/apps/admin"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "TSX Current File Debugger",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Electron: Debug Main Process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/electron-vite-react",
      "runtimeExecutable": "${workspaceFolder}/apps/electron-vite-react/node_modules/.bin/vite",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/apps/electron-vite-react/node_modules/.bin/vite.cmd"
      },
      "runtimeArgs": ["dev"],
      "env": {
        "REMOTE_DEBUGGING_PORT": "9222"
      }
    },
    {
      "name": "Electron: Debug Renderer Process",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/electron-vite-react/src",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Electron: Debug All",
      "configurations": ["Electron: Debug Main Process", "Electron: Debug Renderer Process"],
      "presentation": {
        "order": 1
      }
    }
  ]
}
