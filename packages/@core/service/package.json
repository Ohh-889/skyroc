{
  "name": "@skyroc/service",
  "version": "1.1.0",
  "description": "Platform-agnostic request & query infrastructure with adapter pattern",
  "keywords": [
    "adapter",
    "axios",
    "http-client",
    "react",
    "react-query",
    "request",
    "service",
    "typescript"
  ],
  "homepage": "https://github.com/Ohh-889/skyroc/tree/master/packages/@core/service",
  "bugs": {
    "url": "https://github.com/Ohh-889/skyroc/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ohh",
    "email": "1509326266@qq.com",
    "url": "https://github.com/Ohh-889"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohh-889/skyroc.git",
    "directory": "packages/@core/service"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./query": "./src/query/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./crypto": {
        "import": {
          "types": "./dist/crypto/index.d.ts",
          "default": "./dist/crypto/index.js"
        }
      },
      "./query": {
        "import": {
          "types": "./dist/query/index.d.ts",
          "default": "./dist/query/index.js"
        }
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@skyroc/axios": "workspace:*",
    "@tanstack/react-query": "catalog:core",
    "axios": "catalog:utils",
    "node-forge": "catalog:utils"
  },
  "devDependencies": {
    "@skyroc/config": "workspace:*",
    "@skyroc/tsconfig": "workspace:*",
    "@types/node-forge": "catalog:dev",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
