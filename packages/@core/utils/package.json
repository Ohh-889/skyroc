{
  "name": "@skyroc/utils",
  "version": "4.0.0",
  "description": "Platform-agnostic utility functions (Node / browser / React Native) with ./type, ./web, ./path, ./cn, ./crypto and ./scheduler subpath exports",
  "keywords": [
    "browser",
    "crypto",
    "date",
    "dayjs",
    "platform-agnostic",
    "react",
    "scheduler",
    "storage",
    "task",
    "typescript",
    "utility"
  ],
  "homepage": "https://github.com/Ohh-889/skyroc/tree/master/packages/@core/utils",
  "bugs": {
    "url": "https://github.com/Ohh-889/skyroc/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ohh",
    "email": "1509326266@qq.com",
    "url": "https://github.com/Ohh-889"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohh-889/skyroc.git",
    "directory": "packages/@core/utils"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/date/dayjs.ts",
    "./dist/date/dayjs.js"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cn": "./src/cn.ts",
    "./crypto": "./src/crypto.ts",
    "./path": "./src/path.ts",
    "./scheduler": "./src/scheduler/index.ts",
    "./type": "./src/type/index.ts",
    "./web": "./src/web/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./cn": {
        "import": {
          "types": "./dist/cn.d.ts",
          "default": "./dist/cn.js"
        }
      },
      "./crypto": {
        "import": {
          "types": "./dist/crypto.d.ts",
          "default": "./dist/crypto.js"
        }
      },
      "./path": {
        "import": {
          "types": "./dist/path.d.ts",
          "default": "./dist/path.js"
        }
      },
      "./scheduler": {
        "import": {
          "types": "./dist/scheduler/index.d.ts",
          "default": "./dist/scheduler/index.js"
        }
      },
      "./type": {
        "import": {
          "types": "./dist/type/index.d.ts",
          "default": "./dist/type/index.js"
        }
      },
      "./web": {
        "import": {
          "types": "./dist/web/index.d.ts",
          "default": "./dist/web/index.js"
        }
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "registry": "https://registry.npmjs.org/",
    "sideEffects": [
      "./dist/date/dayjs.js"
    ],
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "clsx": "catalog:utils",
    "crypto-js": "catalog:utils",
    "dayjs": "catalog:utils",
    "klona": "catalog:utils",
    "localforage": "catalog:utils",
    "nanoid": "catalog:utils",
    "radash": "catalog:utils",
    "tailwind-merge": "catalog:utils"
  },
  "devDependencies": {
    "@skyroc/config": "workspace:*",
    "@skyroc/tsconfig": "workspace:*",
    "@types/crypto-js": "catalog:dev",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core"
  }
}
