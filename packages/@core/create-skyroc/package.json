{
  "name": "create-skyroc",
  "version": "1.0.1",
  "description": "Scaffold Skyroc Admin and Expo apps with one command: pnpm create skyroc",
  "keywords": [
    "admin",
    "create",
    "expo",
    "react",
    "scaffold",
    "skyroc",
    "template"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ohh-889/skyroc/tree/master/packages/@core/create-skyroc",
  "bugs": {
    "url": "https://github.com/Ohh-889/skyroc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohh-889/skyroc.git",
    "directory": "packages/@core/create-skyroc"
  },
  "author": {
    "name": "Ohh",
    "email": "1509326266@qq.com",
    "url": "https://github.com/Ohh-889"
  },
  "type": "module",
  "bin": {
    "create-skyroc": "./bin.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsx src/maintenance/build.ts",
    "clean": "rimraf dist",
    "create:workspace": "tsx src/maintenance/create-workspace.ts",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@clack/prompts": "catalog:dev",
    "cac": "catalog:dev",
    "execa": "catalog:dev"
  },
  "devDependencies": {
    "@skyroc/config": "workspace:*",
    "@skyroc/tsconfig": "workspace:*",
    "@tanstack/router-generator": "catalog:web",
    "confbox": "catalog:dev",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:core",
    "vitest": "catalog:dev"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "bin": {
      "create-skyroc": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
