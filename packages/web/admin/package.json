{
  "name": "@skyroc/web-admin-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Admin shell source (devtools / layouts / theme / i18n / notification / runtime / styles / ui / types). Not published: consumed via the @shell/* alias in-repo, and copied into generated projects by `sa create-admin`.",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@better-scroll/core": "catalog:web",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "catalog:ui-shared",
    "@skyroc/color": "workspace:*",
    "@skyroc/core-state": "workspace:*",
    "@skyroc/hooks": "workspace:*",
    "@skyroc/utils": "workspace:*",
    "@skyroc/web-ui": "workspace:*",
    "@tanstack/react-devtools": "catalog:web",
    "@tanstack/react-query": "catalog:core",
    "@tanstack/react-query-devtools": "catalog:web",
    "@tanstack/react-router": "catalog:web",
    "@tanstack/react-router-devtools": "catalog:web",
    "ahooks": "catalog:utils",
    "antd": "catalog:web",
    "clsx": "catalog:utils",
    "dayjs": "catalog:utils",
    "defu": "catalog:utils",
    "i18next": "catalog:i18n",
    "jotai": "catalog:core",
    "jotai-devtools": "catalog:web",
    "motion": "catalog:ui-shared",
    "nprogress": "catalog:ui-shared",
    "react": "catalog:core",
    "react-dom": "catalog:core",
    "react-error-boundary": "catalog:core",
    "react-i18next": "catalog:i18n",
    "tailwind-variants": "catalog:utils"
  },
  "devDependencies": {
    "@skyroc/config": "workspace:*",
    "@skyroc/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/nprogress": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "jsdom": "catalog:dev",
    "oxlint": "catalog:dev",
    "typescript": "catalog:core",
    "vitest": "catalog:dev"
  },
  "engines": {
    "node": ">=20"
  }
}
