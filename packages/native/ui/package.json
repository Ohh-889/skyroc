{
  "name": "@skyroc/native-ui",
  "version": "0.1.0",
  "private": false,
  "description": "React Native UI component library powered by Uniwind (Tailwind CSS v4) for SoybeanAdmin",
  "keywords": [
    "component-library",
    "design-system",
    "expo",
    "react",
    "react-native",
    "skyroc",
    "soybean-admin",
    "tailwind",
    "tailwindcss",
    "typescript",
    "ui",
    "ui-library",
    "uniwind"
  ],
  "homepage": "https://github.com/Ohh-889/skyroc-admin/tree/master/packages/native/ui",
  "bugs": {
    "url": "https://github.com/Ohh-889/skyroc-admin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ohh",
    "email": "1509326266@qq.com",
    "url": "https://github.com/Ohh-889"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohh-889/skyroc-admin.git",
    "directory": "packages/native/ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "components": [
        "./src/components/index.ts"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./theme.css": "./src/styles/theme.css"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "tailwindcss": ">=4",
    "uniwind": ">=1.7.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./components": {
        "import": {
          "types": "./dist/components/index.d.ts",
          "default": "./dist/components/index.js"
        }
      },
      "./theme.css": "./dist/styles/theme.css"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@rn-primitives/slot": "^1.2.0",
    "@skyroc/utils": "workspace:*",
    "tailwind-variants": "catalog:utils"
  },
  "devDependencies": {
    "@skyroc/tsconfig": "workspace:*",
    "@skyroc/ui-types": "workspace:*",
    "@types/react": "catalog:dev",
    "oxlint": "catalog:dev",
    "react": "catalog:native",
    "react-native": "catalog:native",
    "rimraf": "catalog:dev",
    "tailwindcss": "catalog:css",
    "tsdown": "catalog:dev",
    "typescript": "catalog:core",
    "uniwind": "catalog:native"
  }

}
