{
  "name": "@skyroc/expo-wechat",
  "version": "1.0.1",
  "private": false,
  "description": "微信开放平台 SDK 的 Expo 模块封装（登录授权与九种分享）",
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "skyroc",
    "wechat",
    "weixin"
  ],
  "homepage": "https://github.com/Ohh-889/skyroc/tree/master/packages/native/wechat",
  "bugs": {
    "url": "https://github.com/Ohh-889/skyroc/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ohh",
    "email": "1509326266@qq.com",
    "url": "https://github.com/Ohh-889"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ohh-889/skyroc.git",
    "directory": "packages/native/wechat"
  },
  "files": [
    "android/build.gradle",
    "android/src",
    "build",
    "ios/*.podspec",
    "ios/*.swift",
    "app.plugin.js",
    "expo-module.config.json",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "EXPO_NONINTERACTIVE=1 expo-module build",
    "clean": "expo-module clean",
    "expo-module": "expo-module",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "typecheck": "EXPO_NONINTERACTIVE=1 expo-module typecheck"
  },
  "devDependencies": {
    "expo": "~57.0.15",
    "expo-module-scripts": "56.0.3",
    "expo-modules-core": "~57.0.12",
    "oxlint": "catalog:dev",
    "typescript": "catalog:core"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
