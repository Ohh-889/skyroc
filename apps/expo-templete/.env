# ==========================================================================
# 所有环境共用的兜底配置。
#
# !! 这里只能放三套环境完全相同的值 !!
# dev server 下 EXPO_PUBLIC_* 由 Metro 拼一个虚拟模块提供，形如
#   { ...process.env, ...merge('.env', '.env.development', '.env.local', ...) }
# 文件值 spread 在后面，会盖掉 dotenv-cli / 命令行设进 process.env 的值。
# 所以任何按环境变化的 key 一旦写进这里，就再也切不动了 —— 它们属于
# .env.dev / .env.staging / .env.production，那三个后缀 Metro 索引不到。
#
# EXPO_PUBLIC_* 会被 babel 在编译期原样替换进包里，任何人解包都能看到 ——
# 只放公开配置，绝不放密钥。改动这里要重启 dev server（expo start --clear）。
# ==========================================================================

# 请求超时（毫秒），不配默认 10000
EXPO_PUBLIC_API_TIMEOUT=10000

# 后端业务码，多个用英文逗号分隔
EXPO_PUBLIC_SERVICE_SUCCESS_CODE=0000
EXPO_PUBLIC_SERVICE_LOGOUT_CODES=8888,8889
EXPO_PUBLIC_SERVICE_MODAL_LOGOUT_CODES=7777
EXPO_PUBLIC_SERVICE_EXPIRED_TOKEN_CODES=9999

# ==========================================================================
# 原生构建期变量。
#
# 不带 EXPO_PUBLIC_ 前缀 —— 只在 app.config.ts（Node 侧）可见，
# Metro 打包时会被整条剔掉，不会进 JS 包，所以这里放的东西解包看不到。
# 但它们会写进 Info.plist / AndroidManifest，改动后必须重新 prebuild 才生效。
#
# 这三个默认全环境共用；要按环境分（比如正式包用另一个开放平台应用），
# 在 .env.dev / .env.staging / .env.production 里写同名 key 覆盖即可。
# ==========================================================================

# 微信开放平台「移动应用」的 AppID，形如 wx1234567890abcdef。
# 插件会校验 wx 前缀，不合法直接让 prebuild 报错。换成自己的。
# 注意 AppID 本身就是 iOS 的回跳 URL Scheme，改完要重新 prebuild。
WECHAT_APP_ID=wx0000000000000000

# 微信回跳用的 Universal Link。必须是自己域名下、https 开头、以 / 结尾的地址，
# 且与开放平台后台填写的完全一致，否则 iOS 上唤起微信后回不来。
WECHAT_UNIVERSAL_LINK=https://example.com/process/

# Live Activity（灵动岛 / 锁屏）是否走后端远程推送更新。
# 开启会给 App 加 aps-environment 权限，用不带推送能力的证书签名会直接构建失败，
# 所以默认关。要联调后端推送时改成 1 再 prebuild。
LIVE_ACTIVITY_PUSH=0
