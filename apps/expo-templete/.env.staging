# 抢先版 / 预发。经 `pnpm start:staging` / `pnpm ios:staging` 里的 dotenv-cli 加载。
# NODE_ENV 没有 staging 这一档（写成 NODE_ENV=staging 会让 React 走 dev 分支进准生产包），
# 所以只能显式指定文件。`staging` 不在 Metro 的 additionalExts 里，不会被 dev server 抢先覆盖。

APP_ENV=staging

EXPO_PUBLIC_API_BASE_URL=https://m1.apifoxmock.com/m1/8747974-8535971-8438951/

# 需要按环境分微信应用 / Live Activity 推送开关时，在这里写同名 key 覆盖 .env：
# WECHAT_APP_ID= / WECHAT_UNIVERSAL_LINK= / LIVE_ACTIVITY_PUSH=
