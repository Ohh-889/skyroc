{
  "name": "electron-vite-react",
  "version": "2.4.0",
  "private": true,
  "description": "Electron Vite React boilerplate.",
  "license": "MIT",
  "author": "草鞋没号 <308487730@qq.com>",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "pnpm pretest && playwright test",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.main.json && tsc --noEmit --project tsconfig.preload.json"
  },
  "dependencies": {
    "@skyroc/web-ui": "workspace:*",
    "@tanstack/react-devtools": "catalog:web",
    "@tanstack/react-router": "catalog:web",
    "@tanstack/react-router-devtools": "catalog:web",
    "electron-updater": "^6.8.3",
    "jotai": "catalog:core",
    "jotai-devtools": "catalog:web"
  },
  "devDependencies": {
    "@playwright/test": "catalog:dev",
    "@rolldown/plugin-babel": "catalog:dev",
    "@skyroc/tailwind-plugin": "workspace:*",
    "@skyroc/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:css",
    "@tanstack/router-plugin": "catalog:web",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/plugin-react": "catalog:web",
    "babel-plugin-react-compiler": "catalog:dev",
    "boxen": "catalog:dev",
    "electron": "catalog:electron",
    "electron-builder": "catalog:electron",
    "gradient-string": "catalog:dev",
    "jotai-babel": "catalog:dev",
    "react": "catalog:core",
    "react-dom": "catalog:core",
    "tailwindcss": "catalog:css",
    "typescript": "catalog:core",
    "unplugin-auto-import": "catalog:dev",
    "unplugin-icons": "catalog:dev",
    "vite": "catalog:core",
    "vite-plugin-electron": "catalog:electron",
    "vite-plugin-electron-renderer": "catalog:electron",
    "vite-plugin-svg-icons": "catalog:dev",
    "vitest": "catalog:dev"
  }
