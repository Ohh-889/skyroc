# backend service base url, test environment
VITE_SERVICE_BASE_URL=http://127.0.0.1:8000/api/v1

# 本地 FastAPI：后端需同时设置 WEBSOCKET_ENABLED=true
VITE_WEBSOCKET_ENABLED=Y
VITE_WEBSOCKET_URL=ws://127.0.0.1:8000/resource/websocket

# 本地 FastAPI：后端需同时设置 SSE_ENABLED=true
VITE_SSE_ENABLED=Y
VITE_SSE_URL=/resource/sse

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`
