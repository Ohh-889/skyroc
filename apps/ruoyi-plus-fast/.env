VITE_BASE_URL=/

VITE_APP_TITLE=Ruoyi Plus Fast

VITE_APP_DESC=Ruoyi Plus Fast admin application

# the prefix of the icon name
VITE_ICON_PREFIX=icon

# the prefix of the local svg icon component, must include VITE_ICON_PREFIX
# format {VITE_ICON_PREFIX}-{local icon name}
VITE_ICON_LOCAL_PREFIX=icon-local

VITE_AUTH_CAPTCHA_ENABLED=Y

# 客户端 id，对应后端 sys_client.client_id。登录时必传，后端会校验这个端存在、开通了
# password 授权类型、没被停用。这里填的是种子数据里的 PC 端，打成 App 包时换成 App 那一行。
VITE_AUTH_CLIENT_ID=e5cd7e4891bf95d1d19206ce24a7b32e

# WebSocket 与后端 WEBSOCKET_ENABLED / WEBSOCKET_PATH 配套；各环境单独决定是否开启及地址。
VITE_WEBSOCKET_ENABLED=N
VITE_WEBSOCKET_URL=

# SSE 与后端 SSE_ENABLED / SSE_PATH 配套。和 WebSocket 是两条独立的传输，可以同时开，
# 也可以只开一条 —— 后端的连接注册表是同一张，推消息不区分两者。
VITE_SSE_ENABLED=N
VITE_SSE_URL=

# constant route & auth route mode: static ｜ dynamic
VITE_AUTH_ROUTE_MODE=static

# static auth route home path
VITE_ROUTE_HOME=/home

# default menu icon
VITE_MENU_ICON=mdi:menu

# 接口传输加密。只影响调用时标了 encrypt: true 的接口，其余接口不受影响。
# 头名是和后端约定的契约，改要两边一起改（后端 API_CRYPTO_HEADER）。
VITE_API_CRYPTO_HEADER=X-Encrypt-Key
# 加密请求体用的 RSA 公钥，后端持有配对的私钥。PEM 的换行写成 \n。
# 留空时标了 encrypt: true 的请求会直接报错，不会退化成明文发出去。
VITE_API_CRYPTO_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvbmaiekzg1UViOQ937xC\nunHLyhBcZZW9MSylpZ5cb8d9GagCz9t4qcbAlRQv1xfFuEJpOco00jocWAZ74M8W\n7oXAirCOLd77QFI2fPUyezecz1uCzgPcsAdhLzWxJmwS59eIJ/7lJUKlB6NilTfU\nV3vKZANRmRzwtLY+kLRoFP6xZH9npaMxExQiNuy6kb8NCOiNBINVUQGQ00J7AIiF\nDiDnxzC5we5bxYSC2drLVCUWfsNZff+N2Rbi0aVsoDP63tYcMMQZNJnkpaxKnqVi\n9jqxe1tX2qjtLgFJjLRGqolOi92syn113KK/yXhyKobNlEqIAUTNslrXspdtAV+I\nwQIDAQAB\n-----END PUBLIC KEY-----

# whether to enable http proxy when is dev mode
VITE_HTTP_PROXY=Y

# show proxy url log in terminal
VITE_PROXY_LOG=Y

# react-router mode: hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# success code of backend service, when the code is received, the request is successful
VITE_SERVICE_SUCCESS_CODE=0000

# connection ready code of the realtime stream (WebSocket / SSE), when the code is received, the connection is usable
VITE_SERVICE_CONNECTED_CODE=0001

# logout codes of backend service, when the code is received, the user will be logged out and redirected to login page
VITE_SERVICE_LOGOUT_CODES=8888,8889

# modal logout codes of backend service, when the code is received, the user will be logged out by displaying a modal
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778

# token expired codes of backend service, when the code is received, it will refresh the token and resend the request
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# when the route mode is static, the defined super role
VITE_STATIC_SUPER_ROLE=R_SUPER

# sourcemap
VITE_SOURCE_MAP=N

# Used to differentiate storage across different domains
VITE_STORAGE_PREFIX=RUOYI_PLUS_FAST_

# used to control whether the program automatically detects updates
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# backend service base url, test environment
VITE_SERVICE_BASE_URL=https://mock.apifox.cn/m1/3109515-0-default

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`
