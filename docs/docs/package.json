{
  "name": "docs",
  "version": "0.0.15",
  "private": true,
  "scripts": {
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "pnpm run worker:build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "pnpm run worker:build && opennextjs-cloudflare preview",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "upload": "pnpm run worker:build && opennextjs-cloudflare upload",
    "worker:build": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@skyroc/web-ui": "workspace:*",
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@skyroc/tailwind-plugin": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.123.0"
  }
}
