# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Lockfiles (pnpm only) ----------
yarn.lock
package-lock.json

# ---------- Build outputs ----------
dist
dist-ssr
build
out/
server/dist
public/dist
web-build/
.open-next
app-example

# ---------- Caches ----------
.cache
.temp
turbo
.turbo
.next
.source/
.tanstack
.metro-health-check*
.wrangler
.vercel

# ---------- TypeScript ----------
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts
# generated by uniwind's metro transformer on every bundle
uniwind-types.d.ts

# ---------- Expo / React Native ----------
.expo/
.kotlin/
.gradle/
ios/
android/
*.orig.*

# expo module 包里的 ios/android 是手写的原生源码，不是 prebuild 产物，要提交
!packages/native/*/ios/
!packages/native/*/android/
# 但 Gradle 的构建产物照旧忽略
packages/native/*/android/build/
packages/native/*/android/.gradle/

# ---------- Native signing / certificates ----------
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# ---------- Test & coverage ----------
coverage
playwright-report
test-results

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Env & local overrides ----------
.env*.local
*.local

# ---------- Editor / IDE ----------
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Python ----------
# skill 脚本运行后产生的字节码缓存
__pycache__/
*.py[cod]

# ---------- OS ----------
.DS_Store
