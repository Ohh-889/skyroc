{
  "name": "skyroc",
  "private": true,
  "description": "A cross-platform, layered and reusable frontend engineering platform for React, Vite and Expo",
  "keywords": [
    "admin-dashboard",
    "design-system",
    "expo",
    "monorepo",
    "react",
    "react-native",
    "skyroc",
    "turborepo",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/Ohh-889/skyroc",
  "bugs": {
    "url": "https://github.com/Ohh-889/skyroc/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ohh",
    "email": "1509326266@qq.com",
    "url": "https://github.com/Ohh-889"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohh-889/skyroc.git"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "create:admin": "pnpm --filter create-skyroc create:workspace --template admin",
    "create:expo": "pnpm --filter create-skyroc create:workspace --template expo",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "postinstall": "bash scripts/skia-prebuilt.sh --soft --only ios",
    "skia": "bash scripts/skia-prebuilt.sh",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "release:plan": "tsx scripts/release/prepare-release-plan.ts",
    "release:status": "changeset status",
    "release:version": "pnpm release:plan && changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release:build": "tsx scripts/release/build-release-plan.ts",
    "release:publish": "pnpm release:build && changeset publish",
    "test:ui": "vitest --ui",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@skyroc/config": "workspace:*",
    "@skyroc/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "catalog:dev",
    "msw": "catalog:dev",
    "oxfmt": "^0.65.0",
    "oxlint": "catalog:dev",
    "rimraf": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "^4.21.0",
    "turbo": "catalog:dev",
    "typescript": "catalog:core",
    "vitest": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22.11 || ^24 || >=26",
    "pnpm": ">=11"
  }
}
